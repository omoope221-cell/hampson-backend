MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/schoolDB?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES=7d
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
PORT=5000
NODE_ENV=development
SUPER_ADMIN_EMAIL=admin@hampsonsgroupofschool.edu.ng
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Brevo (used for the forgot-password OTP flow and account emails —
# see backend/utils/email.js). Get these from your Brevo dashboard:
# Settings > SMTP & API > API Keys, and Senders for the sender email.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@hampsonsgroupofschool.edu.ng
BREVO_SENDER_NAME=Hampsons Group of School

# Used to build absolute links in outgoing emails (e.g. "Sign in" button).
CLIENT_URL=http://localhost:5173
